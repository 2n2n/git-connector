# Generate a secret with: openssl rand -base64 32
AUTH_SECRET=

# GitHub OAuth App (Settings → Developer settings → OAuth Apps)
# See docs/oauth-setup.md
# Callback URL: http://localhost:3000/api/auth/callback/github
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# GitLab OAuth application (Preferences → Applications on gitlab.com)
# See docs/oauth-setup.md
# Callback URL: http://localhost:3000/api/auth/callback/gitlab
AUTH_GITLAB_ID=
AUTH_GITLAB_SECRET=

# App origin used by Better Auth (required).
AUTH_URL=http://localhost:3000

# Optional. SQLite file for Better Auth. Default: data/auth.sqlite
# See docs/better-auth.md
# AUTH_DATABASE_PATH=data/auth.sqlite
